# Copy to .env.local (git-ignored). Read by `npm run dev` and `npm run db:reset`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csb2

# Who may register
OPEN_UNIVERSITIES=buet
ALLOWED_EMAIL_DOMAINS=buet.ac.bd

# Modules switched on (comma-separated); leave unset for all ten
# MODULES=notices,lost-found,lend-borrow,marketplace

# Outgoing mail; setting either turns on email verification.
# Brevo's HTTPS API works everywhere, including Render's free plan:
# BREVO_API_KEY=xkeysib-...
# SMTP works only where the host allows SMTP ports:
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=CSB 2.0 <you@gmail.com>

# First administrator, created once when the database has none
# ADMIN_EMAIL=you@ugrad.cse.buet.ac.bd
# ADMIN_PASSWORD=a-temporary-password
